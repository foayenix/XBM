# Copy this file to .env and fill in your own values. Never commit .env.

# --- X (Twitter) API ---
# Register an app at https://developer.x.com/en/portal/dashboard
# You need a "Client ID" from an OAuth 2.0 app with the "bookmark.read"
# and "offline.access" scopes enabled. See README.md for the full walkthrough.
X_CLIENT_ID=
# Only needed if your X app is registered as a "confidential" client.
# Public clients (recommended for a local desktop tool) can leave this blank.
X_CLIENT_SECRET=
# Must exactly match the callback URL registered in your X app settings.
X_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# --- Language model ---
# Enrichment uses a model for two small jobs: summarising linked articles and
# suggesting topic tags. Pick ONE of the two setups below.
#
# (a) Claude API. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
#
# (b) A model on your own machine. Set LLM_BASE_URL and LLM_MODEL and leave
# ANTHROPIC_API_KEY blank; setting a base URL switches provider on its own.
# Anything speaking the OpenAI /chat/completions shape works:
#   Ollama         LLM_BASE_URL=http://localhost:11434/v1
#   LM Studio      LLM_BASE_URL=http://localhost:1234/v1
#   llama.cpp      LLM_BASE_URL=http://localhost:8080/v1
#   vLLM           LLM_BASE_URL=http://localhost:8000/v1
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# Most local servers ignore this; a few want any non-empty value.
# LLM_API_KEY=
#
# Shared knobs (either setup):
# LLM_PROVIDER=          # anthropic | openai. Inferred from LLM_BASE_URL.
# LLM_TIMEOUT_SECONDS=120  # raise it if a local model is slow to load
# LLM_MAX_TOKENS=512       # raise it for models that "think" before answering
# LLM_INPUT_CHAR_LIMIT=12000  # lower it for small context windows

# --- App settings ---
# Where the SQLite database file lives.
DATABASE_PATH=db/xbm.sqlite3
# Host/port for the local web UI.
APP_HOST=127.0.0.1
APP_PORT=8000
# Auto-reload the server on code changes. Development only; leave off
# otherwise, it restarts the app on every file write.
APP_RELOAD=0
# Host/Origin values the app answers to, comma-separated. Defaults to
# 127.0.0.1 and localhost on APP_PORT. Pinning these blocks DNS rebinding
# and cross-site requests from other pages in your browser; only widen it
# if you deliberately serve XBM under another name.
# ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
# Run sync + enrichment automatically every N minutes. 0 (default) = off,
# meaning sync only runs when you click "Sync now" or hit /api/sync.
SYNC_INTERVAL_MINUTES=0
